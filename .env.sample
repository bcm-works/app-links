#
# App - used locally AND on Railway (same keys, different values)
#

NEXTAUTH_SECRET=super_random_string
MEILI_MASTER_KEY=another_random_string
# Local: http://localhost:<KARAKEEP_PORT>. Railway: the public domain of the
# web service, e.g. https://<service>.up.railway.app (see docs/INFRA.md).
NEXTAUTH_URL=http://localhost:3333

#
# AI
#

OPENAI_API_KEY=
INFERENCE_TEXT_MODEL=gpt-4.1-mini
INFERENCE_IMAGE_MODEL=gpt-4o-mini

#
# Karakeep - https://docs.karakeep.app/configuration/environment-variables
#

KARAKEEP_VERSION=release
MEILI_VERSION=v1.41.0
KARAKEEP_PORT=3333

# Service wiring. Defaults match compose.yml service names for local
# use. On Railway, override with private-network hostnames, e.g.:
# MEILI_ADDR=http://bcm-links-search.railway.internal:7700
# BROWSER_WEB_URL=http://bcm-links-browser.railway.internal:9222
MEILI_ADDR=http://bcm-links-search:7700
BROWSER_WEB_URL=http://bcm-links-browser:9222
